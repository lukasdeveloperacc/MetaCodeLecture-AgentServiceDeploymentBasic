# ==============================================================================
# Terraform Variables 템플릿 파일 (AWS)
# ==============================================================================
#
# 🎯 사용 방법:
#
# 1. GitHub Actions에서 자동 생성 (권장):
#    GitHub Environments에서 Variables와 Secrets 설정
#    → Workflow에서 자동으로 terraform.tfvars 생성
#
# 2. 로컬 테스트 시:
#    cp terraform.tfvars.example terraform.tfvars
#    vi terraform.tfvars  # 실제 값으로 교체
#
# ⚠️  terraform.tfvars는 .gitignore에 포함되어 있어 Git에 커밋되지 않습니다.

# ------------------------------------------------------------------------------
# 환경 설정
# ------------------------------------------------------------------------------

environment = "${ENVIRONMENT}"
# GitHub Environments: development, staging, production
# 리소스 이름: backend-${ENVIRONMENT}, frontend-${ENVIRONMENT}, agent-cluster-${ENVIRONMENT}

# ------------------------------------------------------------------------------
# VPC 정보 (Section 3/4에서 생성한 기본 VPC 사용)
# ------------------------------------------------------------------------------
#
# 🔍 VPC ID 및 Subnet IDs 확인 방법:
#
#   # VPC ID 확인
#   aws ec2 describe-vpcs \
#     --filters "Name=isDefault,Values=true" \
#     --query 'Vpcs[0].VpcId' \
#     --output text
#
#   # Subnet IDs 확인 (최소 2개, 다른 AZ)
#   aws ec2 describe-subnets \
#     --filters "Name=vpc-id,Values=<VPC_ID>" \
#     --query 'Subnets[*].[SubnetId,AvailabilityZone]' \
#     --output table
#
# GitHub Secrets에 저장:
#   AWS_VPC_ID: vpc-xxxxx
#   AWS_PUBLIC_SUBNET_IDS: ["subnet-xxxxx", "subnet-yyyyy"]

vpc_id = "${AWS_VPC_ID}"
public_subnet_ids = ${AWS_PUBLIC_SUBNET_IDS}

# 예시 (로컬 테스트 시):
# vpc_id = "vpc-0123456789abcdef0"
# public_subnet_ids = ["subnet-abc123", "subnet-def456"]

# ------------------------------------------------------------------------------
# Secrets Manager 시크릿 이름
# ------------------------------------------------------------------------------
#
# 🔍 Secret 이름 확인:
#   aws secretsmanager list-secrets \
#     --region ap-northeast-2 \
#     --query 'SecretList[*].Name'
#
# ⚠️  Section 3에서 생성한 Secrets을 사용합니다.
#
# GitHub Variables에 저장:
#   AWS_OPENAI_SECRET_NAME: dev/openai-api-key
#   AWS_PINECONE_SECRET_NAME: dev/pinecone-api-key

openai_secret_name = "${AWS_OPENAI_SECRET_NAME}"
pinecone_secret_name = "${AWS_PINECONE_SECRET_NAME}"

# 예시 (로컬 테스트 시):
# openai_secret_name = "dev/openai-api-key"
# pinecone_secret_name = "dev/pinecone-api-key"

# ------------------------------------------------------------------------------
# Backend ECS Task 설정
# ------------------------------------------------------------------------------
#
# 💡 CPU와 Memory 호환성:
#   256 CPU:  512-2048 MB
#   512 CPU:  1024-4096 MB
#   1024 CPU: 2048-8192 MB
#   2048 CPU: 4096-16384 MB
#
# GitHub Variables에 저장:
#   BACKEND_CPU: "512"
#   BACKEND_MEMORY: "1024"
#   BACKEND_DESIRED_COUNT: 2

backend_cpu = "${BACKEND_CPU}"
backend_memory = "${BACKEND_MEMORY}"
backend_desired_count = ${BACKEND_DESIRED_COUNT}

# 예시 (로컬 테스트 시):
# backend_cpu = "512"
# backend_memory = "1024"
# backend_desired_count = 2

# ------------------------------------------------------------------------------
# Frontend ECS Task 설정
# ------------------------------------------------------------------------------
#
# GitHub Variables에 저장:
#   FRONTEND_CPU: "256"
#   FRONTEND_MEMORY: "512"
#   FRONTEND_DESIRED_COUNT: 2

frontend_cpu = "${FRONTEND_CPU}"
frontend_memory = "${FRONTEND_MEMORY}"
frontend_desired_count = ${FRONTEND_DESIRED_COUNT}

# 예시 (로컬 테스트 시):
# frontend_cpu = "256"
# frontend_memory = "512"
# frontend_desired_count = 2
