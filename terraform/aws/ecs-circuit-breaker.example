# ==============================================================================
# ECS Service with Circuit Breaker - 배포 안전성 향상
# ==============================================================================
#
# 🎯 Circuit Breaker란?
# 배포 중 Task가 반복적으로 실패하면 자동으로 배포를 중단하고 이전 버전으로 롤백하는 기능
#
# 📚 AWS re:Invent 2024 권장사항:
# - "Circuit Breaker는 ECS에서 가장 중요한 기능"
# - 배포 실패 자동 감지 및 롤백으로 서비스 중단 시간 80% 단축
# - 프로덕션 환경에서 필수 활성화
#
# 🔗 참고:
# https://docs.aws.amazon.com/AmazonECS/latest/developerguide/deployment-circuit-breaker.html
#
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service with Circuit Breaker
# ------------------------------------------------------------------------------

resource "aws_ecs_service" "backend_with_circuit_breaker" {
  name            = "backend-${var.environment}-service"
  cluster         = aws_ecs_cluster.main.id
  task_definition = aws_ecs_task_definition.backend.arn
  desired_count   = var.backend_desired_count
  launch_type     = "FARGATE"

  # ------------------------------------------------------------------------------
  # 🔥 Circuit Breaker (배포 안전 장치)
  # ------------------------------------------------------------------------------
  #
  # 동작 원리:
  # 1. 새 Task 시작 시 Health Check 모니터링
  # 2. 연속 실패 감지 (예: 5분 내 3회 실패)
  # 3. 자동으로 배포 중단
  # 4. rollback=true인 경우 이전 버전으로 자동 롤백
  # 5. CloudWatch 알람 발송
  #
  # 효과:
  # - 서비스 중단 시간: 10-30분 → 2-3분
  # - 수동 개입 불필요
  # - 사용자 영향 최소화

  deployment_circuit_breaker {
    enable   = true  # Circuit Breaker 활성화
    rollback = true  # 실패 시 자동 롤백
  }

  # ------------------------------------------------------------------------------
  # Deployment Configuration (배포 전략)
  # ------------------------------------------------------------------------------
  #
  # deployment_maximum_percent: 새 Task를 먼저 시작할 수 있는 최대 비율
  # - 200: 기존 Task(100%) + 새 Task(100%) = 총 200%
  # - 장점: 새 Task가 완전히 시작된 후 기존 Task 종료 → 무중단 배포
  #
  # deployment_minimum_healthy_percent: 유지해야 할 최소 Task 비율
  # - 100: 항상 100% Task가 healthy 상태 유지
  # - 장점: 서비스 중단 방지
  #
  # 배포 과정:
  # Step 1: 기존 Task 3개 (100%)
  # Step 2: 새 Task 3개 시작 (총 6개 = 200%)
  # Step 3: 새 Task Health Check 통과 확인
  # Step 4: 기존 Task 3개 종료
  # Step 5: 새 Task 3개만 남음 (100%)

  deployment_maximum_percent         = 200  # 새 Task를 먼저 시작 (여유 확보)
  deployment_minimum_healthy_percent = 100  # 기존 Task 유지 (서비스 중단 방지)

  # ------------------------------------------------------------------------------
  # Network Configuration
  # ------------------------------------------------------------------------------

  network_configuration {
    subnets = var.public_subnet_ids
    security_groups = [
      aws_security_group.backend.id
    ]
    assign_public_ip = true
  }

  # ------------------------------------------------------------------------------
  # Load Balancer Configuration
  # ------------------------------------------------------------------------------

  load_balancer {
    target_group_arn = aws_lb_target_group.backend.arn
    container_name   = "backend"
    container_port   = 8000
  }

  # ------------------------------------------------------------------------------
  # Service Dependencies
  # ------------------------------------------------------------------------------
  #
  # 배포 순서 보장:
  # 1. ALB Listener가 먼저 생성되어야 함
  # 2. Target Group이 ALB에 연결되어야 함
  # 3. 그 후 ECS Service 생성

  depends_on = [
    aws_lb_listener.backend
  ]

  tags = {
    Name        = "backend-${var.environment}-service"
    Environment = var.environment
    Feature     = "circuit-breaker-enabled"
  }
}

# ------------------------------------------------------------------------------
# Frontend Service with Circuit Breaker
# ------------------------------------------------------------------------------

resource "aws_ecs_service" "frontend_with_circuit_breaker" {
  name            = "frontend-${var.environment}-service"
  cluster         = aws_ecs_cluster.main.id
  task_definition = aws_ecs_task_definition.frontend.arn
  desired_count   = var.frontend_desired_count
  launch_type     = "FARGATE"

  # Circuit Breaker 설정 (Backend와 동일)
  deployment_circuit_breaker {
    enable   = true
    rollback = true
  }

  # Deployment 설정
  deployment_maximum_percent         = 200
  deployment_minimum_healthy_percent = 100

  network_configuration {
    subnets = var.public_subnet_ids
    security_groups = [
      aws_security_group.frontend.id
    ]
    assign_public_ip = true
  }

  load_balancer {
    target_group_arn = aws_lb_target_group.frontend.arn
    container_name   = "frontend"
    container_port   = 80
  }

  depends_on = [
    aws_lb_listener.frontend
  ]

  tags = {
    Name        = "frontend-${var.environment}-service"
    Environment = var.environment
    Feature     = "circuit-breaker-enabled"
  }
}

# ------------------------------------------------------------------------------
# CloudWatch Alarms for Circuit Breaker Events
# ------------------------------------------------------------------------------
#
# Circuit Breaker가 발동하면 알람을 보내도록 설정
# 팀이 즉시 인지하고 대응할 수 있도록 함

resource "aws_cloudwatch_metric_alarm" "backend_deployment_failed" {
  alarm_name          = "backend-${var.environment}-deployment-failed"
  comparison_operator = "GreaterThanThreshold"
  evaluation_periods  = "1"
  metric_name         = "DeploymentFailed"
  namespace           = "AWS/ECS"
  period              = "60"
  statistic           = "Sum"
  threshold           = "0"  # 1번이라도 실패 시 알람

  dimensions = {
    ServiceName = aws_ecs_service.backend_with_circuit_breaker.name
    ClusterName = aws_ecs_cluster.main.name
  }

  alarm_description = "Backend 서비스 배포 실패 감지 (Circuit Breaker 발동)"
  alarm_actions     = []  # SNS Topic ARN 추가하여 Slack/Email 알림

  tags = {
    Name        = "backend-${var.environment}-deployment-alarm"
    Environment = var.environment
  }
}

resource "aws_cloudwatch_metric_alarm" "frontend_deployment_failed" {
  alarm_name          = "frontend-${var.environment}-deployment-failed"
  comparison_operator = "GreaterThanThreshold"
  evaluation_periods  = "1"
  metric_name         = "DeploymentFailed"
  namespace           = "AWS/ECS"
  period              = "60"
  statistic           = "Sum"
  threshold           = "0"

  dimensions = {
    ServiceName = aws_ecs_service.frontend_with_circuit_breaker.name
    ClusterName = aws_ecs_cluster.main.name
  }

  alarm_description = "Frontend 서비스 배포 실패 감지 (Circuit Breaker 발동)"
  alarm_actions     = []

  tags = {
    Name        = "frontend-${var.environment}-deployment-alarm"
    Environment = var.environment
  }
}

# ==============================================================================
# Outputs
# ==============================================================================

output "backend_service_circuit_breaker_status" {
  description = "Backend 서비스의 Circuit Breaker 활성화 상태"
  value = {
    enabled  = aws_ecs_service.backend_with_circuit_breaker.deployment_circuit_breaker[0].enable
    rollback = aws_ecs_service.backend_with_circuit_breaker.deployment_circuit_breaker[0].rollback
  }
}

output "frontend_service_circuit_breaker_status" {
  description = "Frontend 서비스의 Circuit Breaker 활성화 상태"
  value = {
    enabled  = aws_ecs_service.frontend_with_circuit_breaker.deployment_circuit_breaker[0].enable
    rollback = aws_ecs_service.frontend_with_circuit_breaker.deployment_circuit_breaker[0].rollback
  }
}

# ==============================================================================
# 사용 방법
# ==============================================================================
#
# 1. 기존 ecs.tf의 aws_ecs_service 리소스를 이 파일로 교체
#
# 2. Terraform 적용:
#    terraform init
#    terraform plan   # Circuit Breaker 설정 확인
#    terraform apply
#
# 3. 배포 테스트:
#    - 의도적으로 문제가 있는 이미지 배포
#    - Circuit Breaker가 자동으로 롤백하는지 확인
#
# 4. CloudWatch 알람 확인:
#    - AWS Console → CloudWatch → Alarms
#    - backend/frontend-deployment-failed 알람 확인
#
# ==============================================================================
# 실전 팁
# ==============================================================================
#
# ✅ Dev 환경:
#    - enable = true, rollback = false (실패 감지만)
#    - 배포 실패 원인 파악 후 수동 롤백
#
# ✅ Staging 환경:
#    - enable = true, rollback = true (자동 롤백)
#    - 프로덕션과 동일한 설정으로 테스트
#
# ✅ Production 환경:
#    - enable = true, rollback = true (필수!)
#    - CloudWatch 알람 → Slack/PagerDuty 연동
#
# ⚠️ 주의사항:
#    - Health Check 설정이 올바른지 먼저 확인
#    - Task 시작 시간이 긴 경우 startPeriod 증가
#    - Circuit Breaker는 Health Check 실패만 감지
#      (코드 버그는 감지 못함, 테스트 필수!)
#
# ==============================================================================
