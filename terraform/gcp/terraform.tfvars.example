# ==============================================================================
# Terraform Variables 템플릿 파일 (GCP)
# ==============================================================================
#
# 🎯 사용 방법:
#
# 1. GitHub Actions에서 자동 생성 (권장):
#    GitHub Environments에서 Variables와 Secrets 설정
#    → Workflow에서 자동으로 terraform.tfvars 생성
#
# 2. 로컬 테스트 시:
#    cp terraform.tfvars.example terraform.tfvars
#    vi terraform.tfvars  # 실제 값으로 교체
#
# ⚠️  terraform.tfvars는 .gitignore에 포함되어 있어 Git에 커밋되지 않습니다.

# ------------------------------------------------------------------------------
# GCP 프로젝트 및 리전
# ------------------------------------------------------------------------------
#
# 🔍 Project ID 확인 방법:
#   gcloud config get-value project
#
# 또는 GCP Console:
#   https://console.cloud.google.com → 프로젝트 선택 → 프로젝트 ID 복사
#
# GitHub Variables에 저장:
#   GCP_PROJECT_ID: my-gcp-project-123456
#   GCP_REGION: asia-northeast3

project_id = "${GCP_PROJECT_ID}"
region = "${GCP_REGION}"

# 예시 (로컬 테스트 시):
# project_id = "my-gcp-project-123456"
# region = "asia-northeast3"

# 다른 리전 옵션:
# asia-northeast1 (도쿄)
# us-central1 (아이오와)
# europe-west1 (벨기에)

# ------------------------------------------------------------------------------
# 환경 설정
# ------------------------------------------------------------------------------

environment = "${ENVIRONMENT}"
# GitHub Environments: development, staging, production
# 리소스 이름: backend-${ENVIRONMENT}, frontend-${ENVIRONMENT}, agent-${ENVIRONMENT}

# ------------------------------------------------------------------------------
# Secret Manager 시크릿 이름
# ------------------------------------------------------------------------------
#
# 🔍 Secret 이름 확인:
#   gcloud secrets list
#
# ⚠️  Section 4에서 생성한 Secrets을 사용합니다.
#
# GitHub Variables에 저장:
#   GCP_OPENAI_SECRET_NAME: openai-api-key
#   GCP_PINECONE_SECRET_NAME: pinecone-api-key
#   PINECONE_INDEX_NAME: ai-service-docs-dev

openai_secret_name = "${GCP_OPENAI_SECRET_NAME}"
pinecone_secret_name = "${GCP_PINECONE_SECRET_NAME}"
pinecone_index_name = "${PINECONE_INDEX_NAME}"

# 예시 (로컬 테스트 시):
# openai_secret_name = "openai-api-key"
# pinecone_secret_name = "pinecone-api-key"
# pinecone_index_name = "ai-service-docs-dev"

# ------------------------------------------------------------------------------
# Backend 리소스 설정
# ------------------------------------------------------------------------------
#
# 💡 CPU와 Memory 호환성:
#   1 CPU:  최대 2Gi
#   2 CPU:  최대 4Gi
#   4 CPU:  최대 8Gi
#   8 CPU:  최대 16Gi
#
# GitHub Variables에 저장:
#   BACKEND_CPU: "2"
#   BACKEND_MEMORY: "2Gi"
#   BACKEND_MIN_INSTANCES: 0
#   BACKEND_MAX_INSTANCES: 10

backend_cpu = "${BACKEND_CPU}"
backend_memory = "${BACKEND_MEMORY}"
backend_min_instances = ${BACKEND_MIN_INSTANCES}
backend_max_instances = ${BACKEND_MAX_INSTANCES}

# 예시 (로컬 테스트 시):
# backend_cpu = "2"
# backend_memory = "2Gi"
# backend_min_instances = 0
# backend_max_instances = 10

# ------------------------------------------------------------------------------
# Frontend 리소스 설정
# ------------------------------------------------------------------------------
#
# GitHub Variables에 저장:
#   FRONTEND_CPU: "1"
#   FRONTEND_MEMORY: "512Mi"
#   FRONTEND_MIN_INSTANCES: 0
#   FRONTEND_MAX_INSTANCES: 5

frontend_cpu = "${FRONTEND_CPU}"
frontend_memory = "${FRONTEND_MEMORY}"
frontend_min_instances = ${FRONTEND_MIN_INSTANCES}
frontend_max_instances = ${FRONTEND_MAX_INSTANCES}

# 예시 (로컬 테스트 시):
# frontend_cpu = "1"
# frontend_memory = "512Mi"
# frontend_min_instances = 0
# frontend_max_instances = 5
