# ==============================================================================
# Terraform Variables 예시 파일 (GCP)
# ==============================================================================
#
# 🎯 사용 방법:
# 1. 이 파일을 복사하여 terraform.tfvars 생성:
#    cp terraform.tfvars.example terraform.tfvars
#
# 2. 실제 값으로 교체 (특히 project_id)
#
# 3. terraform apply 실행
#
# ⚠️  주의: terraform.tfvars는 .gitignore에 포함되어 있습니다 (민감 정보 보호)

# ------------------------------------------------------------------------------
# GCP 프로젝트 정보
# ------------------------------------------------------------------------------
#
# 🔍 Project ID 확인 방법:
#   gcloud config get-value project
#
# 또는 GCP Console에서:
#   https://console.cloud.google.com → 프로젝트 선택 → 프로젝트 ID 복사

project_id = "your-gcp-project-id"  # 실제 GCP 프로젝트 ID로 교체

# ------------------------------------------------------------------------------
# 리전 설정
# ------------------------------------------------------------------------------

region = "asia-northeast3"  # 서울 리전 (기본값)

# 다른 리전 사용 시:
# region = "asia-northeast1"  # 도쿄
# region = "us-central1"      # 아이오와
# region = "europe-west1"     # 벨기에

# ------------------------------------------------------------------------------
# 프로젝트 및 환경 정보
# ------------------------------------------------------------------------------

project_name = "agent-service"
environment  = "tf"  # 리소스 이름: backend-tf, frontend-tf, agent-tf

# ------------------------------------------------------------------------------
# Secret Manager 시크릿 이름
# ------------------------------------------------------------------------------
#
# 🔍 Secret 이름 확인 방법:
#   gcloud secrets list
#
# ⚠️  Section 4에서 생성한 Secrets을 사용합니다.
#     아직 생성하지 않았다면 Section 4 문서를 참고하여 먼저 생성하세요.
#
# Secret 생성 예시:
#   echo -n "your-openai-api-key" | gcloud secrets create openai-api-key --data-file=-
#   echo -n "your-pinecone-api-key" | gcloud secrets create pinecone-api-key --data-file=-

openai_secret_name   = "openai-api-key"
pinecone_secret_name = "pinecone-api-key"
pinecone_index_name  = "ai-service-docs-dev"

# ------------------------------------------------------------------------------
# Backend 리소스 설정
# ------------------------------------------------------------------------------
#
# 💡 CPU와 Memory 호환성:
#   1 CPU:  최대 2Gi
#   2 CPU:  최대 4Gi
#   4 CPU:  최대 8Gi
#   8 CPU:  최대 16Gi

backend_cpu    = "2"     # 2 vCPU
backend_memory = "2Gi"   # 2 GB

# ------------------------------------------------------------------------------
# Frontend 리소스 설정
# ------------------------------------------------------------------------------

frontend_cpu    = "1"      # 1 vCPU
frontend_memory = "512Mi"  # 512 MB

# ------------------------------------------------------------------------------
# 스케일링 설정
# ------------------------------------------------------------------------------
#
# 💡 Min Instances:
#   - 0: 요청 없을 때 완전히 축소 (비용 절감)
#   - 1+: 항상 실행 유지 (빠른 응답, 콜드 스타트 방지)
#
# 💡 Max Instances:
#   - 개발 환경: 5-10 (비용 절감)
#   - 프로덕션: 10-100 (트래픽 대응)

# Backend 스케일링
backend_min_instances = 0   # 자동 축소 (비용 절감)
backend_max_instances = 10  # 최대 10개 인스턴스

# Frontend 스케일링
frontend_min_instances = 0
frontend_max_instances = 5

# ------------------------------------------------------------------------------
# 선택적 설정 (고급)
# ------------------------------------------------------------------------------

# 커스텀 도메인 연결 시:
# custom_domain = "api.example.com"

# VPC Connector 사용 시 (VPC 내부 리소스 접근):
# vpc_connector = "projects/PROJECT_ID/locations/REGION/connectors/CONNECTOR_NAME"

# 환경별 설정 예시:
# environment = "dev"    # 개발 환경
# environment = "staging" # 스테이징 환경
# environment = "prod"   # 프로덕션 환경

# ------------------------------------------------------------------------------
# AWS vs GCP 설정 비교
# ------------------------------------------------------------------------------
#
# AWS terraform.tfvars (복잡):
#   - vpc_id 필요 (VPC 정보 필수)
#   - public_subnet_ids 필요 (최소 2개)
#   - secret ARN 필요 (긴 ARN 문자열)
#   - desired_count (고정된 Task 수)
#   → 총 10개 이상의 변수 설정 필요
#
# GCP terraform.tfvars (간단):
#   - project_id만 필수
#   - secret 이름만 필요 (ARN 불필요)
#   - min/max instances (자동 스케일링)
#   → 총 4개 변수만 설정하면 시작 가능!
#
# 왜 GCP가 더 간단한가?
#   - Cloud Run이 완전 관리형 서비스
#   - VPC, Subnet, Security Group 등 인프라 관리 불필요
#   - 기본값이 잘 설정되어 있어 최소 설정만으로 동작
